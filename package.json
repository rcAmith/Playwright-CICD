{
  "name": "e-commerce_playwright",
  "version": "1.0.0",
  "description": "Playwright end-to-end tests for Automation Exercise registration and login flows.",
  "private": true,
  "scripts": {
    "test": "npx playwright test --project=ui-chromium",
    "test:ui:chromium": "playwright test --project=ui-chromium",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:all": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --project=ui-chromium --project=api --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ci": "npm run ci:pr",
    "ci:pr": "npm run typecheck && npm run test:api && npm run test:ui:chromium",
    "ci:full": "npm run typecheck && npm run test:api && npm run test:ui",
    "test:debug": "playwright test --project=ui-chromium --debug",
    "test:ui-debug": "playwright test --project=ui-chromium --debug",
    "test:api-debug": "playwright test --project=api --debug",
    "test:ui-ui": "playwright test --ui --project=ui-chromium",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report test-results/playwright-report",
    "allure:clean": "node -e \"const fs = require('fs'); for (const path of ['allure-results', 'test-results/allure-report']) fs.rmSync(path, { recursive: true, force: true });\"",
    "allure:generate":"allure generate allure-results --clean -o reports/allure-report",
    "allure:open": "allure open test-results/allure-report",
    "allure:serve": "allure serve allure-results",
    "install:browsers": "playwright install",
    "install:browsers:chromium": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "allure"
  ],
  "packageManager": "npm@11.11.0",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.7",
    "dotenv": "^17.4.2",
    "typescript": "^5.9.3"
  }
}
